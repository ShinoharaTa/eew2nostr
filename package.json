{
  "name": "eew2nostr",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test:post": "npm run build && node dist/testing/post-test.js",
    "test": "jest",
    "lint:code": "biome lint ./",
    "lint:style": "biome format ./",
    "fix:style": "biome format --write ./",
    "fix:code": "biome lint --apply ./"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^nostr-tools/(.*)$": "<rootDir>/node_modules/nostr-tools/lib/cjs/$1.js",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node",
            "baseUrl": ".",
            "paths": {
              "nostr-tools/*": ["node_modules/nostr-tools/lib/types/*"]
            }
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@dmdata/telegram-json-types": "^1.1.16",
    "@types/jest": "^29.5.14",
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@atproto/api": "^0.13.28",
    "@concrnt/client": "^0.0.15",
    "@concrnt/worldlib": "^0.1.3",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.10.1",
    "nostr-tools": "^2.10.4",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  }
}
